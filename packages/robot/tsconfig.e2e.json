{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@messages/*": ["./src/messages/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "e2e/**/*.ts",
    "libs.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ]
}
