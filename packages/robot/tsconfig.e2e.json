{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "paths": {
      "@pages/*": ["./src/pages/*"]
    }
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ]
}
